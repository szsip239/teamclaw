# ─── Database ────────────────────────────────────────────
# Docker Compose reads POSTGRES_* when creating the database container.
POSTGRES_USER="teamclaw"
POSTGRES_PASSWORD="<generated-postgres-password>"
POSTGRES_DB="teamclaw"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://teamclaw:<generated-postgres-password>@localhost:5432/teamclaw?schema=public"

# ─── Redis ───────────────────────────────────────────────
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379"

# ─── JWT RS256 Keys (Base64 encoded) ─────────────────────
# Generate with: node scripts/generate-keys.mjs --write
JWT_PRIVATE_KEY="<base64-encoded-RS256-private-key>"
JWT_PUBLIC_KEY="<base64-encoded-RS256-public-key>"

# ─── JWT Configuration ───────────────────────────────────
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
JWT_ISSUER="teamclaw"

# ─── Encryption ──────────────────────────────────────────
# 32-byte hex key for AES-256-CBC. Generate with: openssl rand -hex 32
ENCRYPTION_KEY="<64-char-hex-string>"

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=""                     # Leave empty for relative URLs (works with any access method)
NODE_ENV="development"
APP_PORT="3100"

# ─── Initial Admin ───────────────────────────────────────
# Used only when prisma/seed.ts creates the first admin user.
INITIAL_ADMIN_EMAIL="admin@teamclaw.local"
INITIAL_ADMIN_PASSWORD="<generated-initial-admin-password>"

# ─── RAG Service ─────────────────────────────────────────
# Host-mode Next.js should use http://localhost:8000.
# Docker app containers override this to http://rag:8000.
RAG_SERVICE_URL="http://localhost:8000"
RAG_SERVICE_SECRET="<generated-rag-service-secret>"

# Current recommended RAG model stack:
# - LLM: qwen3.5-35b-a3b via DashScope OpenAI-compatible endpoint
# - Embedding: BAAI/bge-m3 via SiliconFlow, 1024 dimensions
# - Optional rerank: BAAI/bge-reranker-v2-m3, configured in the admin RAG UI
# - OCR: PP-OCRv5 via PaddleOCR cloud API. Keep this model unless you
#   re-validate ingestion and retrieval quality; other OCR models may reduce recall.
# LLM used by knowledge-base ingestion summaries and final answers.
# These can also be configured in the UI: System Settings -> RAG Settings.
LLM_API_KEY=""
DASHSCOPE_API_KEY=""
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL="qwen3.5-35b-a3b"

# Embedding/rerank defaults. BAAI/bge-m3 returns 1024-dimensional vectors,
# so PGVECTOR_EMBED_DIM must stay 1024 unless you rebuild rag.* tables.
SILICONFLOW_API_KEY=""
SILICONFLOW_EMBEDDING_URL="https://api.siliconflow.cn/v1/embeddings"
SILICONFLOW_EMBEDDING_MODEL="BAAI/bge-m3"
SILICONFLOW_EMBEDDING_BATCH_SIZE="10"
PGVECTOR_EMBED_DIM="1024"

# PaddleOCR cloud API used for PDF ingestion.
PADDLEOCR_TOKEN=""
PADDLEOCR_MODEL="PP-OCRv5"
PADDLEOCR_JOB_URL="https://paddleocr.aistudio-app.com/api/v2/ocr/jobs"
PADDLEOCR_RETRY_ATTEMPTS="3"
PADDLEOCR_RETRY_BACKOFF="5"
PADDLEOCR_POLL_INTERVAL="5"
PADDLEOCR_STALL_TIMEOUT="180"
PADDLEOCR_JOB_TIMEOUT="1800"
PADDLEOCR_CHUNK_PAGE_THRESHOLD="48"
PADDLEOCR_CHUNK_SIZE="40"

# Ingestion and answer rendering budgets.
INGEST_DEFAULT_WORKERS="4"
INGEST_MAX_WORKERS="12"
DOCUMENT_CHAPTER_SUMMARY_CHUNK_SIZE="40"
DOCUMENT_PROFILE_MAX_TOKENS="384"
DOCUMENT_CHAPTER_SUMMARY_MAX_TOKENS="4096"
UPLOAD_RENDER_DPI="110"
UPLOAD_RENDER_MAX_PIXELS="900000"
UPLOAD_RENDER_JPEG_QUALITY="72"
LLM_RENDER_MAX_PIXELS="640000"
LLM_RENDER_JPEG_QUALITY="60"
MULTI_DOC_TOTAL_PAGE_BUDGET="15"
MULTI_DOC_PER_DOC_PAGE_LIMIT="6"
MULTI_DOC_SINGLE_DOC_PAGE_LIMIT="30"

# ─── Nginx (optional, use with --profile nginx) ─────────
NGINX_SERVER_NAME="_"              # Domain name (e.g. "example.com")
NGINX_HTTPS_PORT="443"             # HTTPS listen port
NGINX_HTTP_PORT="80"               # HTTP listen port (redirects to HTTPS)
NGINX_SSL_CERT="server.crt"        # Certificate filename in nginx/cert/
NGINX_SSL_KEY="server.key"         # Private key filename in nginx/cert/

# ─── Docker ──────────────────────────────────────────────
# Path to Docker socket on the host
# macOS Docker Desktop: /var/run/docker.sock (default)
# Linux: /var/run/docker.sock (or check `docker context inspect`)
DOCKER_SOCKET_PATH="/var/run/docker.sock"
# GID of the docker.sock owner. Required for app container to access Docker API.
# macOS: 0 (root owns the socket)
# Linux: run `stat -c '%g' /var/run/docker.sock`
DOCKER_GID="0"

# ─── OpenClaw Instance Defaults ──────────────────────────
# Default model provider for new instances (used when no per-instance key is specified)
DEFAULT_MODEL_PROVIDER="anthropic"
DEFAULT_MODEL_API_KEY=""
DEFAULT_MODEL_BASE_URL="https://api.anthropic.com"
DEFAULT_MODEL_API_TYPE="anthropic-messages"

# Instance data storage directory (host absolute path, used for Docker volume mounts)
# setup.sh will auto-detect: ~/.teamclaw/instances
TEAMCLAW_DATA_DIR=""
# Default Docker image for new OpenClaw instances
DEFAULT_OPENCLAW_IMAGE="alpine/openclaw:2026.6.6-browser"
